# 301-Weiterleitungen
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Eine einzige Adresse: http:// und www. dauerhaft auf https://oh-haustechnik.de.
  # Ohne diese Regeln existierte die Seite dreifach (http, https, www) und Google
  # verteilt die Autoritaet auf drei Duplikate.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://oh-haustechnik.de%{REQUEST_URI} [R=301,L]

  # Ehemalige Zimmer-Einzelseiten -> eine Sanierungs-Seite
  RewriteRule ^[234]-zimmer-wohnung-elektro-sanieren-nuernberg\.php$ /wohnung-elektro-sanieren-nuernberg.php [R=301,L]
  # E-Check-Seite umbenannt: DGUV V3 wird nicht angeboten
  RewriteRule ^e-check-dguv-v3-nuernberg\.php$ /e-check-nuernberg.php [R=301,L]

  # Kopien der alten Website: waren ohne noindex erreichbar und damit
  # Duplikate der Hauptseiten. Dauerhaft auf die heutigen Gegenstuecke.
  RewriteRule ^index-alt-analyticsrocket\.html$ / [R=301,L]
  RewriteRule ^elektriker-nuernberg\.html$ / [R=301,L]
  RewriteRule ^(.+)-alt-analyticsrocket\.html$ /$1.php [R=301,L]
</IfModule>

# Sensible Dateien vor oeffentlichem Download schuetzen (Backups, Datenbanken, Keys, Logs)
<FilesMatch "\.(zip|bak|sql|env|log|tar|gz)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Browser-Caching. Ohne diese Angaben laedt jeder Besucher bei jedem Aufruf
# saemtliche Bilder, Schriften und Stylesheets erneut. Google bewertet das
# unter "Zielseitenerfahrung" mit, und die geht in den Qualitaetsfaktor der
# Anzeigen ein.
#
# Bilder und Schriften stehen auf ein Jahr: die aendern sich praktisch nie.
# CSS und JavaScript bewusst nur auf sieben Tage, weil die Dateien ohne
# Versionsnummer eingebunden sind. Eine Aenderung an funnel.css wuerde bei
# einem Jahr Cache erst nach einem Jahr bei wiederkehrenden Besuchern
# ankommen. Wer das aendern will, haengt beim Einbinden ein ?v=... an und
# kann die Frist dann hochsetzen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff     "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType model/gltf-binary         "access plus 1 year"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType text/javascript           "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|mp4|glb)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # PHP-Seiten nie zwischenspeichern: die Bewertungszahlen und der
  # Funnel-Inhalt werden zur Laufzeit erzeugt.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
